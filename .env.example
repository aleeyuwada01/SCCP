# JWT_SECRET: Secret key for signing JWT tokens.
# Change this in production!
JWT_SECRET="sccp-super-secret-key"

# TURSO_DATABASE_URL: (Optional) Turso hosted database URL.
# If not set, falls back to local SQLite file (sccp.db).
# Get yours free at https://turso.tech
TURSO_DATABASE_URL=""

# TURSO_AUTH_TOKEN: (Optional) Turso auth token.
# Required if TURSO_DATABASE_URL is set.
TURSO_AUTH_TOKEN=""

# GEMINI_API_KEY: (Optional) For Gemini AI features.
GEMINI_API_KEY=""
